;; Rematerialize ALU-op-with-imm and iconsts in each block where they're
;; used. This is neutral (add-with-imm) or positive (iconst) for
;; register pressure, and these ops are very cheap.
(rule (simplify x @ (iadd _ (iconst _ _) _))
      (remat x))
(rule (simplify x @ (iadd _ _ (iconst _ _)))
      (remat x))
(rule (simplify x @ (isub _ (iconst _ _) _))
      (remat x))
(rule (simplify x @ (isub _ _ (iconst _ _)))
      (remat x))
(rule (simplify x @ (band _ (iconst _ _) _))
      (remat x))
(rule (simplify x @ (band _ _ (iconst _ _)))
      (remat x))
(rule (simplify x @ (bor _ (iconst _ _) _))
      (remat x))
(rule (simplify x @ (bor _ _ (iconst _ _)))
      (remat x))
(rule (simplify x @ (bxor _ (iconst _ _) _))
      (remat x))
(rule (simplify x @ (bxor _ _ (iconst _ _)))
      (remat x))
(rule (simplify x @ (bnot _ _))
      (remat x))
(rule (simplify x @ (iconst _ _))
      (remat x))
(rule (simplify x @ (f32const _ _))
      (remat x))
(rule (simplify x @ (f64const _ _))
      (remat x))
;; stack_addr lowers to a single `lea r,[rsp+K]` (x64) /
;; `add r,sp,#K` (aarch64) — same cost class as iconst, and a
;; spill-reload of its result is strictly worse than re-emitting it.
;; Without this, a `stack_addr(slot, 0)` repeated at N call sites
;; GVN-hoists to one entry-block Value and regalloc2 (no remat for
;; the lowered `lea`) spills it body-wide and reloads at each
;; fixed-arg call site.
(rule (simplify x @ (stack_addr _ _ _))
      (remat x))
;; get_frame_pointer lowers to a single reg-move from a fixed preg
;; (`mov r,%rbp` on x64, `mov r,fp` on aarch64). Same rationale as
;; stack_addr: without this, N per-site emissions GVN to one
;; entry-block value that spills body-wide.
(rule (simplify x @ (get_frame_pointer _))
      (remat x))
